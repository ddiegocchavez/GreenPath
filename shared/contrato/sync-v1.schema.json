{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "greenpath/sync-v1",
  "title": "GreenPath · resumen diario de uso (v1)",
  "description": "Foto acumulada del uso de apps de un día en un dispositivo. Reemplaza al envío anterior del mismo día si su observed_at es más reciente; nunca se suma. El usuario se obtiene del JWT, no de este cuerpo.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "device_id", "timezone", "local_date", "period_start", "period_end", "observed_at", "source", "items"],
  "properties": {
    "schema_version": { "const": 1 },
    "device_id": { "type": "string", "format": "uuid", "description": "UUID v4 generado al instalar y guardado localmente" },
    "device_label": { "type": "string", "maxLength": 80 },
    "timezone": { "type": "string", "description": "Zona IANA, p. ej. America/Mexico_City" },
    "local_date": { "type": "string", "format": "date", "description": "Día local al que pertenece el resumen" },
    "period_start": { "type": "string", "format": "date-time", "description": "Inicio consultado (00:00 local) con desfase" },
    "period_end": { "type": "string", "format": "date-time", "description": "Fin consultado con desfase" },
    "observed_at": { "type": "string", "format": "date-time", "description": "Momento de la observación; decide qué envío es más reciente" },
    "source": { "const": "android_usagestats" },
    "is_demo": { "type": "boolean", "default": false, "description": "true en datos de demostración" },
    "items": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["app_id", "foreground_ms"],
        "properties": {
          "app_id": { "type": "string", "maxLength": 255, "description": "Nombre de paquete Android" },
          "app_label": { "type": "string", "maxLength": 120 },
          "foreground_ms": { "type": "integer", "minimum": 0, "maximum": 86400000, "description": "Tiempo en primer plano, en milisegundos" }
        }
      }
    }
  }
}
